# 默认启动不需要复制此文件。需要自定义时复制为 configs/.env。
DEBUG=true
# 相对路径按项目根目录解析；另设目录可隔离演示或检查数据。
BOOKLOOP_DATA_DIR=data

DB_DIALECT=sqlite
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=bookcycle

USE_REDIS=false
REDIS_URL=redis://127.0.0.1:6379/0

STORAGE_TYPE=local
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=bookcycle
S3_REGION=us-east-1
PUBLIC_BASE_URL=

SECRET_KEY=replace-with-a-random-secret-before-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
# 留空时自动生成并保存 data/.aes_key；数据库与该文件必须成对备份。
AES_KEY=

# 仅在第一次初始化对应账号时生效。
DEMO_PWD=campus@2026
ADMIN_PWD=admin@2026

WECHAT_APPID=
WECHAT_SECRET=
WECHAT_MODE=mp_h5
WECHAT_REDIRECT_URI=http://127.0.0.1:8000/
WECHAT_MOCK=true

AI_ENABLED=true
AI_BASE_URL=https://token.sensenova.cn/v1
AI_API_KEY=
AI_MODEL=deepseek-flash
AI_MODELS=
AI_FALLBACK_MODEL=
AI_MAX_TOKENS=4096
AI_TIMEOUT_SECONDS=45
AI_HOURLY_LIMIT=100
